    {
      "slug": "rotation-map",
      "order": 30,
      "label": "Rotation Map",
      "description": "Which links, business types and sectors are moving: returns, breadth, volume and crosses by group.",
      "status": "experimental",
      "asofAware": true,
      "capabilities": {
        "data": true,
        "observe": true,
        "screenshot": true,
        "drilldown": true
      },
      "settings_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "group_by": {
            "type": "string",
            "enum": [
              "link",
              "business_type",
              "sector",
              "card"
            ]
          },
          "include_silent": {
            "type": "boolean"
          },
          "vs_spy": {
            "type": "boolean"
          },
          "sort_col": {
            "type": "string",
            "enum": [
              "label",
              "names",
              "ret_1d",
              "ret_7d",
              "ret_30d",
              "ret_90d",
              "ret_1y",
              "above_50d",
              "rvol20",
              "golden",
              "death",
              "rs_leaders"
            ]
          },
          "sort_dir": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "open_groups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "maxItems": 200
          },
          "flagged_open": {
            "type": "boolean"
          }
        }
      },
      "defaults": {
        "group_by": "link",
        "include_silent": false,
        "vs_spy": false,
        "sort_col": "ret_7d",
        "sort_dir": "desc",
        "open_groups": [],
        "flagged_open": false
      },
      "backend_query_fields": [
        "group_by",
        "include_silent"
      ],
      "capability_version": "1",
