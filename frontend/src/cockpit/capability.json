  "backend_query_fields": ["thesis_id"],
  "response_paths": ["/clock", "/theses/{uuid}", "/theses/{uuid}/call", "/theses/{uuid}/display-signals", "/theses/{uuid}/data-flags", "/workbench/theses/{uuid}/scored", "/theses/{uuid}/decisions"]
